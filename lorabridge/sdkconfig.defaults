CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=y
CONFIG_BT_NIMBLE_ROLE_CENTRAL=n
CONFIG_BT_NIMBLE_ROLE_OBSERVER=n
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=y
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
CONFIG_ESP_TASK_WDT_TIMEOUT_S=30
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_FREERTOS_HZ=1000

# NimBLE mbuf pool — увеличен для поддержки больших BLE уведомлений (>1КБ JSON)
# Пул 1: 24 блока × 256 байт = 6144 байт (было 12×256 = 3072)
CONFIG_BT_NIMBLE_MSYS_1_BLOCK_COUNT=24
CONFIG_BT_NIMBLE_MSYS_1_BLOCK_SIZE=256

# V2.6.1: bridge_on_ble_rx работает в задаче NimBLE — NVS-запись (setname)
# переполняла дефолтные 4КБ стека → stack overflow на T3
CONFIG_BT_NIMBLE_HOST_TASK_STACK_SIZE=8192
